  "dialogues": {
    "mira": [
      {
        "lines": [
          "You’ve got your first crewmate. Want to audition the other two?"
        ],
        "when": {
          "heard_pitch": true
        },
        "choices": [
          {
            "label": "Audition starters",
            "action": "starter"
          },
          {
            "label": "See you out there"
          }
        ]
      },
      {
        "lines": [
          "Wander Onys is buying this whole district one contract at a time.",
          "Earn the trust of three indie labels in open-mic sets. Together, we can challenge their flagship."
        ],
        "sets": {
          "heard_pitch": true
        },
        "choices": [
          {
            "label": "Audition starters",
            "action": "starter"
          },
          {
            "label": "I’ll start with Beatcub"
          }
        ]
      }
    ],
    "basement": [
      {
        "lines": [
          "I’m Juno. Basement Rhythms keeps the city’s oldest records spinning.",
          "Show me you can hold a set and I’ll sign on."
        ],
        "choices": [
          {
            "label": "Take the mic",
            "action": "battle"
          },
          {
            "label": "Come back later"
          }
        ]
      }
    ],
    "tape": [
      {
        "lines": [
          "No ghostwriters on this pier. Show my crew you can build a verse in the moment."
        ],
        "choices": [
          {
            "label": "Start the set",
            "action": "battle"
          },
          {
            "label": "Come back later"
          }
        ]
      }
    ],
    "echo": [
      {
        "lines": [
          "You’ve got two labels behind you. Let’s see if you can carry the room."
        ],
        "choices": [
          {
            "label": "Start the set",
            "action": "battle"
          },
          {
            "label": "Come back later"
          }
        ]
      }
    ],
    "basement_after": [
      {
        "lines": [
          "Basement Rhythms is in. Look for Sol down at Tape Deck Pier."
        ]
      }
    ],
    "tape_after": [
      {
        "lines": [
          "Tape Deck is with you. Echo House is up the east end of the avenue."
        ]
      }
    ],
    "echo_after": [
      {
        "lines": [
          "All three labels are on the bill. Head east to the Wander Onys flagship."
        ]
      }
    ],
    "onys": [
      {
        "lines": [
          "You brought the whole district to my doorstep. If you want the mic, take it."
        ],
        "choices": [
          {
            "label": "Challenge Wander Onys",
            "action": "battle"
          },
          {
            "label": "Prepare first"
          }
        ]
      }
    ],
    "onys_after": [
      {
        "lines": [
          "The broadcast is yours. Dockside’s artists can keep their own masters."
        ]
      }
    ],
    "crate": [
      {
        "lines": [
          "Rare imports, demo tapes, vocal remedies. Everything still analog."
        ],
        "choices": [
          {
            "label": "Browse stock",
            "action": "shop"
          },
          {
            "label": "Maybe later"
          }
        ]
      }
    ],
    "roadie": [
      {
        "lines": [
          "The tall sound grass near the docks is full of unsigned artists. Wear them down and offer a Demo Tape."
        ]
      }
    ],
    "dancer": [
      {
        "lines": [
          "Boom Bap rattles Drill. Drill cuts through Funk. Funk goes right under Boom Bap."
        ]
      }
    ],
    "benny": [
      {
        "lines": [
          "A good producer comes prepared. Here’s a spare demo."
        ],
        "when": {
          "got_demo": false
        },
        "choices": [
